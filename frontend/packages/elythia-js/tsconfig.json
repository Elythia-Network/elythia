{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"lib": [
			"esnext",
			"dom"
		]
	},
	"include": [
		"src/**/*"
	]
}
