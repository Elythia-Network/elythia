# Binary
/elythia
/misskey
/misskey-go
/built/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of go coverage
*.out

# Go workspace
go.work
go.work.sum

# Dependency directories
vendor/
.pnpm-store/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Temporary files
.tmp/
# 比較対象の本家 (make upstream-fetch、#3378)
.cache/

# Config (user-specific). Track example templates only; operator
# copies them locally (default.yml / docker.yml).
.config/*
!.config/*.example
drive-files/
/deploy/uds/config/default.yml
/compose.uds.yaml

# Benchmark results
tests/bench/http/results/*.json
tests/bench/http/results/*.md
tests/bench/http/results/profiles/
tests/bench/queue/results/*.json
tests/bench/queue/results/*.md
# faker の go build の出力 (#1517 で誤って追跡されていた。#3373 で外した)
tests/bench/queue/faker/faker
!tests/bench/http/results/.gitkeep
# #1158 effect の before/after reference data (#1163 で計測)。reader が
# bench を再走らせなくても docs/queue-bench.md の表と数値を突き合わせて
# verify できるよう、この 2 ファイルだけ track する。他の *.json は
# bench 走るたびに上書きされる ephemeral data なので gitignore のまま。
!tests/bench/queue/results/inbound-announce-before.json
!tests/bench/queue/results/inbound-announce-after.json

# Claude Code local state。rules/ だけは共有する (#3248)。
# `.claude/` と書くとディレクトリごと除外され、中の再包含が効かないので `/*` にする
.claude/*
!.claude/rules/
# 運営者の環境に固有のルール (#3248)。Claude Code は CLAUDE.md の後に自動で読む
CLAUDE.local.md
__pycache__/

# Cypress runtime artifacts (tests/dropin-frontend/cypress and e2e/cypress 配下)
**/cypress/videos/
**/cypress/screenshots/
**/cypress/downloads/
**/cypress/node_modules/
**/cypress/.cache/
# cypress 15 は project dir 配下に `cypress/` を tmp として作ることがある
tests/dropin-frontend/cypress/cypress/

# drop-in test orchestrator が失敗時に吐くログ (local fallback)
.dropin-logs/

# プラグイン (#2480)。運営者が plugins/ に置いたものと、そこから生成される
# ファイル。mk-go 本体のリポジトリには持たない。
#
# 例外は plugins/status と plugins/trustlevel。**常に動くサンプル**として同梱する (#2483) —
# 別リポジトリに置くと plugin/ を変えたときに壊れても CI で気付けない。
plugins/*
!plugins/.gitkeep
!plugins/status/
# trustlevel も同梱する (#2586)。#2585 の公開面を実プラグインで検証する台なので、
# ツリー外に置くと CI で `plugin/` の破壊に気付けない (status と同じ理由)。
!plugins/trustlevel/
go.work
go.work.sum
cmd/elythia/plugins_generated.go

# pluginbuild (make plugins) の生成物 (#3379)。frontend はこれを import するので、
# frontend をビルドする前に make plugins を回す。追跡すると make plugins のたびに
# 作業ツリーが dirty になり、運営者の git pull が止まりうる。
/frontend/packages/frontend/src/server-plugins.generated.ts
/frontend/packages/frontend/mk-plugins.generated.json

# #3379 で外した submodule の残り。片付ける前に `git add -A` すると、中の .git を
# 埋め込みリポジトリとして gitlink で追加してしまう。片付けの手順は docs/deployment.md。
/third_party/
