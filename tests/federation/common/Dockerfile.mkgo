# syntax=docker/dockerfile:1.7
#
# Dockerfile used only by tests/federation/compose.*.yml to run mk-go
# inside federation tests. Unlike the main Dockerfile its entrypoint runs
# `elythia migrate` before starting the server.
#
# Build context must be the repository root.
# `# syntax=` directive は BuildKit cache mount 用 (#432)。
FROM golang:1.27.1-alpine AS builder

RUN apk add --no-cache git build-base

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o /app/built/elythia ./cmd/elythia

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /app/built/elythia /app/elythia
COPY --from=builder /app/migration /app/migration

# Frontend asset bundle (Playwright frontend operation 用)。本家 Dockerfile と
# 同 layout で COPY + 環境変数で path を bind する。host で `make e2e-frontend-build`
# が実行され `frontend/built/` 系が存在することが前提。federation /
# drop-in test で frontend 不要の場合は単に reference されないだけで害はない。
COPY --from=builder /app/frontend/built/_frontend_vite_ /app/built/_frontend_vite_
COPY --from=builder /app/frontend/built/_frontend_dist_ /app/built/_frontend_dist_
COPY --from=builder /app/frontend/built/_sw_dist_ /app/built/_sw_dist_
# embed 専用 bundle (#2389)。通常 SPA とは別 build なので別ディレクトリ。
# これが無いと /embed_vite/* が 404 になる (dev モード以外では dev server へ proxy しない)。
COPY --from=builder /app/frontend/built/_frontend_embed_vite_ /app/built/_frontend_embed_vite_
COPY --from=builder /app/frontend/packages/frontend/assets /app/client-assets
# upstream 2026.5.2 #17381 で `@discordapp/twemoji/dist/svg` から
# `@misskey-dev/emoji-assets/built/twemoji` に asset path が移行 (本体
# Dockerfile では追従済、本ファイルは drift していたので合わせる)。
COPY --from=builder /app/frontend/node_modules/@misskey-dev/emoji-assets/built/twemoji /app/twemoji
COPY --from=builder /app/frontend/assets /app/static-assets
COPY --from=builder /app/frontend/repo-assets /app/repo-assets
ENV MISSKEY_FRONTEND_DIR=/app/built/_frontend_vite_
ENV MISSKEY_FRONTEND_DIST_DIR=/app/built/_frontend_dist_
ENV MISSKEY_SW_DIST_DIR=/app/built/_sw_dist_
ENV MISSKEY_CLIENT_ASSETS_DIR=/app/client-assets
ENV MISSKEY_TWEMOJI_DIR=/app/twemoji
ENV MISSKEY_STATIC_DIR=/app/static-assets
ENV MISSKEY_REPO_ASSETS_DIR=/app/repo-assets

COPY tests/federation/common/mkgo-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
