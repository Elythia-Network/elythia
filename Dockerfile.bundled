# フロントエンドアセットを同梱した mk-go イメージ。
#
# 既存の `Dockerfile` はアセットのうち静的なものだけを焼き込み、SPA 本体
# (約 200MB) は `frontend/built` の bind-mount で渡す。そのため publish した
# イメージが単体では起動できない。こちらは frontend/ を image の中でビルドして
# 同梱するので、pull しただけで起動できる。ホストの frontend/built や
# node_modules には一切依存しない (検証目的のビルドで本番の配信元を壊さない)。
#
# 以前は fork (shiroha-a/misskey-ts) が publish する assets image を digest で
# 引いていた。frontend を本体へ取り込んだので、ここでビルドする (#3379)。
# プラグインの frontend も常に含まれる (以前の ASSETS_SOURCE=local は要らない)。
#
# 使い方:
#   docker build -f Dockerfile.bundled -t mk-go:bundled .
#   docker compose -f docker-compose.image.yml up -d   (publish 済みイメージを pull)

# Stage 1: プラグインの組み込み用ファイルを生成する
#
# plugins/ に置かれたプラグインをビルドに取り込む (#2940)。生成物は gitignore
# されているので、ここで生成しないと **image だけプラグイン無しになる**。しかも
# エラーにならないので、運営者は「入ったつもり」で起動できてしまう。生成物は
# Go 側 (cmd/misskey/plugins_generated.go) と frontend 側
# (server-plugins.generated.ts など) の両方で、下の 2 つの stage が使う。
#
# patch version まで固定する (`Dockerfile` と同じ理由)。go.mod の `go` directive
# と揃っていることを CI の `vulncheck` job が見る。tag だけでは中身が固定されない
# ので digest を併記する (`Dockerfile` と同じ値。更新は dependabot の `docker` が
# digest ごと上げる)。
FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS plugingen

# git は go mod download 時の private module fetch に使う (通常の Dockerfile と同じ)。
# plugins/ のプラグインが private な依存を持つ場合にここで要る。
RUN apk add --no-cache git

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOWORK=off go run ./tools/pluginbuild && \
    mkdir -p /gen/src && \
    cp frontend/packages/frontend/src/server-plugins.generated.ts /gen/src/ && \
    if [ -f frontend/packages/frontend/mk-plugins.generated.json ]; then \
        cp frontend/packages/frontend/mk-plugins.generated.json /gen/; \
    fi

# Stage 2: Go binary
#
# `-tags nodynamic` は必須。CGO_ENABLED=0 だけでは gen2brain/webp の purego
# (dlopen) 経路が残って musl に動的リンクされ、distroless で
# `exec /app/misskey: no such file or directory` になる (#619)。
FROM plugingen AS builder
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/misskey ./cmd/misskey && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/migrate ./cmd/migrate && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/backfill-remote-host ./cmd/backfill-remote-host && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/backfill-emoji-system-file ./cmd/backfill-emoji-system-file && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/backfill-avatar-public-url ./cmd/backfill-avatar-public-url && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/backfill-instance-counts ./cmd/backfill-instance-counts

# Stage 3: frontend
#
# frontend/ の SPA をビルドする。手順は CI (frontend.yml) と同じだが、配るのに
# 要る 4 つの成果物 (frontend / sw / frontend-embed と、それらが依存する
# workspace package) だけに絞る。
#
# **`--platform=$BUILDPLATFORM` で動かす。** 成果物は JS と静的ファイルだけで
# アーキテクチャに依存しないので、別アーキテクチャの image を作るときにエミュ
# レーションでビルドしない (数倍遅くなる)。
#
# **Node の版は frontend/.node-version と揃える。** 揃っていることを
# internal/entitycompat の bundled_node_version_test が見る。tag だけでは中身が
# 固定されないので digest を併記する。
FROM --platform=$BUILDPLATFORM node:26.4.0-trixie@sha256:b46a10d964ad15136ebdf9012142131481caa0697d7a4d4eafe4bbabd818f876 AS frontend

# frontend / sw / i18n / misskey-js など 7 パッケージが NODE_ENV を見ており、
# production でないと minify されず _DEV_ フラグも立つ。
ENV NODE_ENV=production
# pnpm 11 は npm_config_* を読まないので pnpm_config_* で渡す (実測)。npm_config_store_dir
# だった間は cache mount の /pnpm-store が使われず、毎回取り直していた。
ENV pnpm_config_store_dir=/pnpm-store

WORKDIR /work/frontend

# pnpm は package.json の packageManager から入れる (Node 26 には corepack が
# 同梱されていない)。`pnpm fetch` は lock だけで依存を取得し、node_modules/.pnpm まで
# 作る (依存の postinstall もここで走る)。ソースより先に行って、ソースの変更で
# 取り直さないようにする。
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN node -e "console.log(JSON.parse(require('node:fs').readFileSync('./package.json')).packageManager)" | xargs npm install -g
RUN --mount=type=cache,target=/pnpm-store pnpm fetch --frozen-lockfile

# build context はホストの frontend/built を含む (.dockerignore は UDS 構成と連合 e2e の
# ために残している) ので、持ち込んだ古い成果物を下で消してから作る。
COPY frontend/ ./
# プラグインの frontend は ../../../plugins/*/frontend から import される
# (packages/frontend/tsconfig.json)。生成物は Stage 1 が作ったものを使う。
# manifest (mk-plugins.generated.json) は frontend を持つプラグインがあるときにしか
# 作られないので、Stage 1 が /gen に集めたものをディレクトリごと重ねる。
COPY plugins/ /work/plugins/
# build context に入っているホストの古い生成物を消してから重ねる。manifest は
# Stage 1 が作らなかったときに古いものが残り、使われない alias が入る。
RUN rm -f packages/frontend/src/server-plugins.generated.ts packages/frontend/mk-plugins.generated.json
COPY --from=plugingen /gen/ packages/frontend/
RUN --mount=type=cache,target=/pnpm-store \
    rm -rf built && \
    pnpm install --offline --frozen-lockfile && \
    pnpm build-pre && \
    pnpm --filter frontend... --filter sw... --filter frontend-embed... build && \
    pnpm build-assets

# Stage 4: Runtime
FROM gcr.io/distroless/static-debian13:latest@sha256:58133991db06659feaabe0f4e97a35cebf15ef4ea08f8a4c6d2ee5f75e4aa6a0

WORKDIR /app

COPY --from=builder /app/built/misskey /app/misskey
COPY --from=builder /app/built/migrate /app/migrate
# 後始末バッチ。runtime は distroless で shell が無いので、entrypoint を差し替えた
# 使い捨てコンテナで流す (手順は docs/deployment.md の「後始末バッチ」)。
#   docker compose -f docker-compose.image.yml run --rm --no-deps \
#     --entrypoint /app/backfill-emoji-system-file app -config /app/.config/default.yml
# **`Dockerfile` と揃えること。** bundled にだけ入っていないと、bundled image を
# 配っている構成 (docker-compose.image.yml が既定で指す) で doc の手順がそのまま
# 落ちる。
COPY --from=builder /app/built/backfill-remote-host /app/backfill-remote-host
COPY --from=builder /app/built/backfill-emoji-system-file /app/backfill-emoji-system-file
COPY --from=builder /app/built/backfill-avatar-public-url /app/backfill-avatar-public-url
COPY --from=builder /app/built/backfill-instance-counts /app/backfill-instance-counts
COPY --from=builder /app/migration /app/migration
COPY .config/docker.yml.example /app/.config/default.yml

# アセットはすべて frontend stage から取る。ホストの frontend/built や
# node_modules には依存しない。
COPY --from=frontend /work/frontend/assets                  /app/static-assets
COPY --from=frontend /work/frontend/repo-assets             /app/repo-assets
COPY --from=frontend /work/frontend/node_modules/@misskey-dev/emoji-assets/built/twemoji      /app/twemoji
COPY --from=frontend /work/frontend/node_modules/@misskey-dev/emoji-assets/built/fluent-emoji /app/fluent-emoji
COPY --from=frontend /work/frontend/built                   /app/frontend
COPY --from=frontend /work/frontend/packages/frontend/assets /app/client-assets

ENV MISSKEY_STATIC_DIR=/app/static-assets \
    MISSKEY_REPO_ASSETS_DIR=/app/repo-assets \
    MISSKEY_TWEMOJI_DIR=/app/twemoji \
    MISSKEY_FLUENT_EMOJI_DIR=/app/fluent-emoji \
    MISSKEY_FRONTEND_DIR=/app/frontend/_frontend_vite_ \
    MISSKEY_FRONTEND_DIST_DIR=/app/frontend/_frontend_dist_ \
    MISSKEY_CLIENT_ASSETS_DIR=/app/client-assets

EXPOSE 3000

# 既存 Dockerfile と同じく Misskey TS 互換の UID/GID で起動する。
# ドライブの保存先は 991:991 が書き込める所有権にすること (#621)。
USER 991:991

ENTRYPOINT ["/app/misskey"]
CMD ["-config", ".config/default.yml"]
