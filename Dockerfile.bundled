# フロントエンドアセットを同梱した mk-go イメージ。
#
# 既存の `Dockerfile` はホスト側で `pnpm install && pnpm build` 済みであること
# を前提に submodule からアセットを COPY し、SPA 本体 (約 200MB) は
# `third_party/misskey/built` の bind-mount で渡す。そのため
#
#   - イメージのビルドがホストの状態に依存して再現しない
#   - bind-mount 先が本番の配信元と同一で、検証目的のビルドで本番を壊せる
#   - publish したイメージが単体で起動できない
#
# という問題がある。こちらは fork が publish するアセット専用イメージから
# すべてを COPY するので、submodule のホスト状態に一切依存せず、pull した
# だけで起動できる。
#
# 既存の `Dockerfile` / `docker-compose.yml` / `make docker-*` は変更していない。
# 従来のビルド&起動フローはそのまま使える。
#
# 使い方:
#   docker build -f Dockerfile.bundled -t mk-go:bundled .
#   docker compose -f docker-compose.image.yml up -d   (publish 済みイメージを pull)

# **tag と digest を併記する。** tag は付け替えられるので、tag だけだと fork 側で
# 同じ tag を publish し直したとき (あるいは registry の書き込み権を奪われたとき)
# に中身が黙って変わる。digest があると BuildKit は tag を無視して digest で
# pull する。tag を残すのは doc の pin 行と突き合わせるため
# (`make submodulepin-check`)。**tag を上げたら digest も必ず取り直す** — 古い
# digest のままだと tag だけ新しい古い frontend が焼き込まれる。docker.yml の
# `build-and-push-bundled` が tag と digest の対応を registry に問い合わせて確かめる。
# 取り直し方は docs/upstream-catch-up.md。
ARG MISSKEY_ASSETS_IMAGE=ghcr.io/shiroha-a/misskey-ts-assets:2026.9.1-mk.1@sha256:588ceee6b6b014d9f6218a3520dad246a44b66b05770fdcb40a47a05c3ca37a9

# アセットの供給元。既定は external (公式のアセットイメージ) で、プラグインの
# frontend を含めたいときだけ local に切り替える (#2940)。
#
# **最初の FROM より前に宣言しなければならない。** FROM の変数展開に使えるのは
# global ARG だけで、stage の中で宣言したものは展開に参加しない。しかも
# `--build-arg` を渡しても救われない (未宣言の build-arg は metaArgs に入らない)
# ので、置き場所を間違えると `assets-` という不正な stage 名になり **既定の
# ビルドまで落ちる**。
ARG ASSETS_SOURCE=external

# Stage 1: Go binary
#
# 既存 Dockerfile の builder stage と同じ手順。ただし submodule のアセットを
# 参照しないので、`pnpm install` 済みかどうかの事前チェックは不要。
#
# patch version まで固定する (`Dockerfile` と同じ理由)。go.mod の `go` directive
# と揃っていることを CI の `vulncheck` job が見る。上の assets image と同じく
# tag だけでは中身が固定されないので、base image も digest を併記する
# (`Dockerfile` と同じ値。更新は dependabot の `docker` が digest ごと上げる)。
FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder

# git は go mod download 時の private module fetch に使う (通常の Dockerfile と同じ)。
# plugins/ のプラグインが private な依存を持つ場合にここで要る。
RUN apk add --no-cache git

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# `-tags nodynamic` は必須。CGO_ENABLED=0 だけでは gen2brain/webp の purego
# (dlopen) 経路が残って musl に動的リンクされ、distroless で
# `exec /app/misskey: no such file or directory` になる (#619)。
#
# plugins/ に置かれたプラグインをビルドに取り込む (#2940)。生成物は gitignore
# されているので、ここで生成しないと **image だけプラグイン無しになる**。しかも
# エラーにならないので、運営者は「入ったつもり」で起動できてしまう。
#
# **frontend を持つプラグインを含めるには ASSETS_SOURCE=local が要る。** 既定の
# assets イメージは mk-go 公式のビルドなので、プラグインの .vue は入っていない。
# pluginbuild は submodule 未取得かつ frontend を持つプラグインがあるとき明示的に
# 落ちるので、片肺で組み込まれた image が黙って出来ることはない。
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOWORK=off go run ./tools/pluginbuild && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/misskey ./cmd/misskey && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/migrate ./cmd/migrate && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/backfill-remote-host ./cmd/backfill-remote-host && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/backfill-emoji-system-file ./cmd/backfill-emoji-system-file && \
    CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /app/built/backfill-avatar-public-url ./cmd/backfill-avatar-public-url

# Stage 2: フロントエンドアセット
#
# fork (shiroha-a/misskey-ts) が `X.Y.Z-mk.N` タグごとに publish する
# `FROM scratch` のデータイメージ。backend を含まないので 228MB
# (Misskey フルイメージは 1.66GB)。
#
# タグは submodule のタグと 1:1 で対応させること。ずれるとフロントエンドと
# backend の実装がちぐはぐになる。`make version` で両方を確認できる。
FROM ${MISSKEY_ASSETS_IMAGE} AS assets-external

# プラグインの frontend を含む SPA を自前でビルドしたときの供給元 (#2940)。
# 公式の assets イメージにはプラグインの .vue が入っていないので、frontend を
# 持つプラグインを組み込むときは build context 側でビルドした成果物を使う。
# 中身は Dockerfile.assets が作る 5 つと同じ形にしてある (ずれると runtime stage
# の COPY が落ちる)。
#
# **使わない stage は BuildKit がビルドしない**ので、ASSETS_SOURCE=external の
# ときに third_party/misskey/built が無くても問題ない。
FROM scratch AS assets-local
COPY third_party/misskey/built /built
COPY third_party/misskey/packages/frontend/assets /frontend-assets
COPY third_party/misskey/packages/backend/assets /backend-assets
COPY third_party/misskey/assets /repo-assets
COPY third_party/misskey/packages/backend/node_modules/@misskey-dev/emoji-assets/built /emoji-assets

FROM assets-${ASSETS_SOURCE} AS assets

# Stage 3: Runtime
FROM gcr.io/distroless/static-debian13:latest@sha256:58133991db06659feaabe0f4e97a35cebf15ef4ea08f8a4c6d2ee5f75e4aa6a0

WORKDIR /app

COPY --from=builder /app/built/misskey /app/misskey
COPY --from=builder /app/built/migrate /app/migrate
# 後始末バッチ。runtime は distroless で shell が無いので、entrypoint を差し替えた
# 使い捨てコンテナで流す (手順は docs/deployment.md の「後始末バッチ」)。
#   docker compose -f docker-compose.image.yml run --rm --no-deps \
#     --entrypoint /app/backfill-emoji-system-file app -config /app/.config/default.yml
# **`Dockerfile` と揃えること。** bundled にだけ入っていないと、bundled image を
# 配っている構成 (docker-compose.image.yml が既定で指す) で doc の手順がそのまま
# 落ちる。
COPY --from=builder /app/built/backfill-remote-host /app/backfill-remote-host
COPY --from=builder /app/built/backfill-emoji-system-file /app/backfill-emoji-system-file
COPY --from=builder /app/built/backfill-avatar-public-url /app/backfill-avatar-public-url
COPY --from=builder /app/migration /app/migration
COPY .config/docker.yml.example /app/.config/default.yml

# アセットはすべて assets イメージ由来。submodule には触れない。
COPY --from=assets /backend-assets  /app/static-assets
COPY --from=assets /repo-assets     /app/repo-assets
COPY --from=assets /emoji-assets/twemoji      /app/twemoji
COPY --from=assets /emoji-assets/fluent-emoji /app/fluent-emoji
COPY --from=assets /built           /app/frontend
COPY --from=assets /frontend-assets /app/client-assets

ENV MISSKEY_STATIC_DIR=/app/static-assets \
    MISSKEY_REPO_ASSETS_DIR=/app/repo-assets \
    MISSKEY_TWEMOJI_DIR=/app/twemoji \
    MISSKEY_FLUENT_EMOJI_DIR=/app/fluent-emoji \
    MISSKEY_FRONTEND_DIR=/app/frontend/_frontend_vite_ \
    MISSKEY_FRONTEND_DIST_DIR=/app/frontend/_frontend_dist_ \
    MISSKEY_CLIENT_ASSETS_DIR=/app/client-assets

EXPOSE 3000

# 既存 Dockerfile と同じく Misskey TS 互換の UID/GID で起動する。
# ドライブの保存先は 991:991 が書き込める所有権にすること (#621)。
USER 991:991

ENTRYPOINT ["/app/misskey"]
CMD ["-config", ".config/default.yml"]
