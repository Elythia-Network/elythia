# mk-go - Application Environment Variables
#
# **mk-go は .env を読まない。** 参考値の一覧として置いてある。実際に効かせるには
# シェルで export するか、`set -a; . ./.env; set +a` のように読み込むこと。
# (テスト用の .env.test だけは internal/testutil が自動で読む)

# All paths are relative to the repository root, matching the defaults in
# internal/frontendutil (frontendBase = "frontend").

# Frontend assets directory (built Misskey frontend)
MISSKEY_FRONTEND_DIR=frontend/built/_frontend_vite_

# Frontend dist directory (locales, fonts)
MISSKEY_FRONTEND_DIST_DIR=frontend/built/_frontend_dist_

# Twemoji SVG directory
MISSKEY_TWEMOJI_DIR=frontend/node_modules/@misskey-dev/emoji-assets/built/twemoji

# Fluent Emoji directory (achievement badges / notification icons)
MISSKEY_FLUENT_EMOJI_DIR=frontend/node_modules/@misskey-dev/emoji-assets/built/fluent-emoji

# Client assets directory
MISSKEY_CLIENT_ASSETS_DIR=frontend/packages/frontend/assets

# Static assets directory (favicon, splash, icons etc.)
MISSKEY_STATIC_DIR=frontend/assets

# Repository-root assets (ai.png, banner etc.)
MISSKEY_REPO_ASSETS_DIR=frontend/repo-assets
